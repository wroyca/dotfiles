; https://git-scm.com/docs/git-config

[user]
name = {{ .name | quote }}
email = {{ .email | quote }}

[advice]
detachedHead = false

[branch]
sort = -committerdate

[column]
ui = auto

[commit]
verbose = true

[commitGraph]
changedPaths = true
changedPathsVersion = 2

[core]
editor = code --wait
excludesFile = ~/.config/git/excludes

[credential]
helper = /usr/bin/git-credential-manager
credentialStore = cache
cacheOptions = --timeout 86400

[diff]
algorithm = histogram
renames = copies

[feature]
manyFiles = true
experimental = true

[fetch]
followRemoteHEAD = always

[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true

[help]
autoCorrect = 10

[init]
defaultBranch = main
defaultRefFormat = files

[merge]
conflictStyle = zdiff3

[pull]
rebase = true

[push]
autoSetupRemote = true
followTags = true

[rebase]
abbreviateCommands = true
instructionFormat = %s%nexec \
  GIT_COMMITTER_DATE=\"$(git show -s --no-notes --no-show-signature --format=%%cI %H)\" \
  GIT_COMMITTER_NAME=\"$(git show -s --no-notes --no-show-signature --format=%%cN %H)\" \
  GIT_COMMITTER_EMAIL=\"$(git show -s --no-notes --no-show-signature --format=%%cE %H)\" \
  git commit --amend --no-edit%n

[rerere]
enabled = true
autoUpdate = true

[status]
compareBranches = @{upstream} @{push}

[submodule]
recurse = true
fetchJobs = 10

[url "https://github.com/"]
insteadOf = git@github.com:
