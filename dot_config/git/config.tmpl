; https://git-scm.com/docs/git-config

[user]
name = {{ .name | quote }}
email = {{ .email | quote }}

[advice]
detachedHead = false

[branch]
sort = -committerdate

[column]
ui = auto

[commit]
verbose = true

[commitGraph]
changedPaths = true
changedPathsVersion = 2

[core]
editor = code --wait
excludesFile = ~/.config/git/excludes
attributesFile = ~/.config/git/attributes

[credential]
helper = /usr/bin/git-credential-manager
credentialStore = cache
cacheOptions = --timeout 86400

[diff]
algorithm = histogram
renames = copies

[feature]
manyFiles = true
experimental = true

[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true

[help]
autoCorrect = 1

[init]
defaultBranch = main
defaultRefFormat = files

; BLOCKED: https://github.com/orgs/community/discussions/12490
;
; defaultObjectFormat = sha256

[merge]
conflictStyle = zdiff3

[pull]
twohead = ort
rebase = true

[push]
autoSetupRemote = true
followTags = true

[rebase]
abbreviateCommands = true
instructionFormat = %s%nexec GIT_COMMITTER_DATE=\"%cI\" GIT_COMMITTER_NAME=\"%cN\" GIT_COMMITTER_EMAIL=\"%cE\" git commit --amend --no-edit%n

[rerere]
enabled = true
autoUpdate = true

[submodule]
recurse = true
fetchJobs = 10

[url "https://github.com/"]
insteadOf = git@github.com:
